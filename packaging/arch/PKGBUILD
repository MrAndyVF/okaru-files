# okaru-files: compila la rama main del checkout (OKARU_FILES_REPO, por defecto ~/Projects/okaru-project/okaru-files).
pkgname=okaru-files
pkgver=1.1.0
pkgrel=1
pkgdesc='OKARU (郁): el gestor de archivos'
arch=(x86_64)
url='https://github.com/MrAndyVF/okaru-files'
license=(MIT)
# Sin ABI estable: depende de la versión exacta del núcleo con el que se compiló (la instalada al compilar).
_core=$(pacman -Q okaru-core 2>/dev/null | cut -d' ' -f2)
depends=("okaru-core${_core:+=$_core}")
makedepends=(meson ninja pkgconf okaru-core tomlplusplus nlohmann-json) # nlohmann-json: la piden las cabeceras del núcleo (okaru-core <= 1.2.4 no la declaraba)
optdepends+=('kdeconnect: teléfonos / phones')
optdepends+=('sshfs: archivos del teléfono / phone files')
optdepends+=('gvfs: papelera, recientes, red y unidades extraíbles / trash, recent, network and removable drives'
            'gvfs-smb: carpetas compartidas de Windows y Samba / Windows and Samba shares'
            'gvfs-nfs: carpetas compartidas NFS / NFS shares'
            'gvfs-mtp: teléfonos y cámaras por cable USB / phones and cameras over USB'
            'gvfs-wsdd: equipos Windows de la red / Windows computers on the network'
            'ffmpegthumbnailer: miniaturas de video / video thumbnails'
            'libreoffice-fresh: vista previa de documentos de oficina / office document previews')
options=('!debug' '!lto')
source=("okaru-files::git+file://${OKARU_FILES_REPO:-$HOME/Projects/okaru-project/okaru-files}#branch=main")
sha256sums=(SKIP)

pkgver() {
  cd okaru-files
  git describe --long --tags --abbrev=9 --match 'v*' | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  arch-meson okaru-files build -Dtests=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 okaru-files/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
